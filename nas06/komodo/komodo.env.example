# Secrets for the Komodo stack. The real file lives ONLY on nas06 at
#   ${CONFIG_ROOT}/komodo/komodo.env   (default /mnt/tank/config/komodo/komodo.env, mode 600)
# Generate values with: openssl rand -hex 32
# Hex avoids characters that break the Mongo connection URL.

# MongoDB root user (must match the KOMODO_DATABASE_* pair below)
MONGO_INITDB_ROOT_USERNAME=komodo
MONGO_INITDB_ROOT_PASSWORD=change-me

# Komodo Core's login to MongoDB
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=change-me

# Password for the initial web UI user "admin" (only used on first start)
KOMODO_INIT_ADMIN_PASSWORD=change-me

# Signs login tokens
KOMODO_JWT_SECRET=change-me

# Shared with GitHub webhooks (repo Settings > Webhooks > Secret)
KOMODO_WEBHOOK_SECRET=change-me
