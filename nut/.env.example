# Copy to .env for local `docker compose` use, OR (preferred) set this value in the
# Portainer stack's "Environment variables" section so it never lands in git.
#
# This password is shared by every upsmon that connects to upsd:
#   - the nut-upsd container's own internal upsmon
#   - server03's native upsmon (primary)
#   - homebridge01's native upsmon (secondary)
# It must be identical everywhere. Pass the SAME value to the host install.sh scripts.
NUT_PASSWORD=change-me-to-a-strong-password

# Login password for the PeaNUT web dashboard (username is "admin").
PEANUT_WEB_PASSWORD=change-me-too
